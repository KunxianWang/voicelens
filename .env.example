DATABASE_URL=postgresql+psycopg2://voicelens:voicelens@localhost:5432/voicelens
QDRANT_URL=http://localhost:6333

# Where the codebase keeps fixtures / generated samples (committed)
DATA_DIR=voicelens/data

# Where the user drops large external datasets (not committed)
EXTERNAL_DATA_DIR=data

# Real Amazon Reviews 2023 inputs (user-supplied; place under EXTERNAL_DATA_DIR)
AMAZON_REVIEWS_PATH=data/Electronics.jsonl
# Optional. If set, used to look up brand by ASIN.
# AMAZON_METADATA_PATH=data/meta_Electronics.jsonl

# Filtering / batching
BRAND_ALLOWLIST=Anker,Soundcore,Bose,JBL,UGREEN,RAVPower,Aukey
INGEST_LIMIT=50000

LOG_LEVEL=INFO
